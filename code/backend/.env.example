# Copy this file to .env and change the values for your machine.

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/finshield
SECRET_KEY=replace-with-any-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Which of Member 2's models to use: xgboost, random_forest or logistic_regression
ML_MODEL_NAME=xgboost

# Only set this if the model files are stored outside the sibling ml folder.
# ML_MODELS_DIR=../member2_ml
